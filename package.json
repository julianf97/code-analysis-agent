{
  "name": "code-analysis-agent",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "check": "tsc --noEmit && npm run check:tests",
    "check:tests": "tsc --project tests/tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:migrate": "npm run build && node scripts/migrate-db.js up",
    "db:migrate:undo": "npm run build && node scripts/migrate-db.js down",
    "db:migrate:status": "npm run build && node scripts/migrate-db.js status",
    "migrate": "npm run db:migrate",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@langchain/openai": "^1.6.0",
    "dotenv": "^18.0.4",
    "express": "^4.21.2",
    "langchain": "^1.5.14",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
