{
  "name": "code-analysis-agent",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc",
    "check": "tsc --noEmit && npm run check:tests",
    "check:tests": "tsc --project tests/tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "db:migrate": "npm run build && node scripts/migrate-db.js up",
    "db:migrate:undo": "npm run build && node scripts/migrate-db.js down",
    "db:migrate:status": "npm run build && node scripts/migrate-db.js status",
    "migrate": "npm run db:migrate",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@langchain/openai": "^1.6.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/typeorm": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.4",
    "langchain": "^1.5.14",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
