NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=code_analysis
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public
DB_TEST_SCHEMA=code_analysis_test
DB_USE_TEST_SCHEMA=false
ADMIN_API_KEY=replace_with_a_long_random_secret_at_least_32_chars
GITHUB_TOKEN=replace_with_fine_grained_read_only_pat
OPENAI_API_KEY=replace_with_openai_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_REASONING=gpt-4.1
OPENAI_MODEL_REPORT=gpt-4.1-mini
MAX_CONCURRENT_JOBS=1
MAX_PARALLEL_ANALYZERS=2
MAX_GITHUB_REQUESTS=3
MAX_OPENAI_REQUESTS=2
GLOBAL_BUDGET_USD=10
DEFAULT_ANALYSIS_BUDGET_USD=1
